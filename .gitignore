# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
/media
# full-quality music sources; the site uses the re-encoded copies in assets/audio
/music

# 50 MB working file for the guests (rebuild with tools/guests/build.py)
tools/guests/*.blend
tools/guests/*.blend1

# per-guest Blender working files (87 MB): local only, never deployed (tools/guests/split_guests.py makes them)
assets/chars/blenderfiles/

# the character creator's modular Blender files (16 MB): local only; export_modular.py turns them into assets/chars/avatar_*.glb
assets/chars/blenderfilesmodular/
